# Copy to .env and fill in. Never commit the real file.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production database. Without it, SQLite is used.
# DATABASE_URL=postgres://erp:password@localhost:5432/school_erp
# POSTGRES_PASSWORD=change-me

# Shared cache for the login rate limit. Without it, DEBUG=0 uses a database cache table
# (create it once with: python manage.py createcachetable).
# CACHE_URL=redis://localhost:6379/0

# SMS. The console backend only prints to the log.
SMS_BACKEND=messaging.backends.ConsoleSMSBackend

# Email, used for password resets.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=school@example.com
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Transport security, applied only when DJANGO_DEBUG=0.
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_SUBDOMAINS=1
# DJANGO_HSTS_PRELOAD=1
